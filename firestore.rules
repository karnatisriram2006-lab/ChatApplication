rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Profiles
    // Anyone authenticated can read (needed for search and chat headers).
    // Only the owner can update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat Requests
    // Only the two participants in the requestId (which is the roomId) can read or write.
    match /chatRequests/{requestId} {
      allow read, write: if request.auth != null 
        && requestId.split('_').hasAny([request.auth.uid]);
    }

    // Messages
    // Split into separate read and write rules for clarity.
    // READ:  The authenticated user's UID must be part of the stored roomId.
    // WRITE: The authenticated user's UID must be part of the roomId they are writing into.
    //        This prevents spoofing (writing into someone else's chat).
    match /messages/{messageId} {
      allow read: if request.auth != null
        && resource.data.roomId.split('_').hasAny([request.auth.uid]);

      allow create: if request.auth != null
        && request.resource.data.roomId.split('_').hasAny([request.auth.uid])
        && request.resource.data.author == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.roomId.split('_').hasAny([request.auth.uid]);

      allow delete: if request.auth != null
        && resource.data.author == request.auth.uid;
    }

  }
}
